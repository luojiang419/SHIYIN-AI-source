{
  "name": "shiyin-ai-windows-desktop",
  "private": true,
  "version": "2.0.4",
  "scripts": {
    "canvas:engine-build": "esbuild src/canvas-engine-upstream/bridge.tsx --bundle --minify --format=iife --target=chrome110 --outfile=static/vendor/js/infinite-canvas-engine.js",
    "css:build": "node ./node_modules/tailwindcss/lib/cli.js -c tailwind.config.cjs -i ./static/css/tailwind-input.css -o ./static/vendor/css/tailwind.generated.css --minify",
    "desktop:dev": "powershell -ExecutionPolicy Bypass -File tools/start-desktop-dev.ps1",
    "desktop:host-build": "npm run css:build && tauri build --no-bundle",
    "desktop:build": "npm run update:publish",
    "original:installer": "powershell -ExecutionPolicy Bypass -File tools/build-original-installer.ps1",
    "installer:build": "powershell -ExecutionPolicy Bypass -File tools/build-installer.ps1",
    "installer:release": "powershell -ExecutionPolicy Bypass -File tools/release-installer.ps1",
    "release:publish": "powershell -ExecutionPolicy Bypass -File tools/release-installer.ps1",
    "version:patch": "powershell -ExecutionPolicy Bypass -File tools/increment-version.ps1",
    "update:publish": "npm run canvas:engine-build && powershell -ExecutionPolicy Bypass -File tools/publish-lan-hot-update.ps1",
    "distribution:build": "powershell -ExecutionPolicy Bypass -File tools/build-distribution-center.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "^0.25.12",
    "playwright": "^1.58.2",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
