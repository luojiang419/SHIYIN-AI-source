[Unit]
Description=SHIYIN AI remote clip read-only media service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/clipdata
ExecStart=/usr/bin/python3 /opt/clipdata/.service/clip_media_server.py --root /opt/clipdata --host 0.0.0.0 --port 18080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/clipdata

[Install]
WantedBy=multi-user.target
